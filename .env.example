# ── Ambigua LLM configuration ────────────────────────────────────────────────
# Ambigua runs fully offline by default (deterministic heuristic engine).
# Live LLM mode calls a real model. Providers are tried in priority order and it
# uses the first that answers — a missing/expired key never breaks the app.
#
# Copy to .env and edit. .env is gitignored. Never commit real keys.

# --- Local Ollama (no key; works out of the box if Ollama is running) --------
# This is the default live provider in this workspace.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma3:12b

# --- Hosted providers (uncomment ONE and add a key) --------------------------
# OPENAI_API_KEY=***
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=***
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# OPENROUTER_API_KEY=***
# OPENROUTER_MODEL=openai/gpt-4o-mini

# ZAI_API_KEY=***
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# ZAI_MODEL=glm-4-flash

# --- Selection / tuning ------------------------------------------------------
# Force a specific provider: ollama | openai | anthropic | openrouter | zai
# LLM_PROVIDER=ollama
# LLM_TIMEOUT_MS=45000

# --- Server ------------------------------------------------------------------
# PORT=4321
